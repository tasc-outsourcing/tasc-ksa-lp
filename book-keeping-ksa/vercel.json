{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/uae-vat-filing", "destination": "/index.html" },
    { "source": "/uae-vat-filing/", "destination": "/index.html" },
    { "source": "/uae-vat-filing/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/uae-vat-filing/:path*", "destination": "/index.html" }
  ]
}
